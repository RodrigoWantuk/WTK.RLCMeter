{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host-debug",
      "displayName": "Host Debug",
      "description": "Configure host-side C tests with debug flags.",
      "binaryDir": "${sourceDir}/build/host-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "WTK_TARGET_PLATFORM": "host"
      }
    },
    {
      "name": "host-release",
      "displayName": "Host Release",
      "description": "Configure host-side C tests with release flags.",
      "binaryDir": "${sourceDir}/build/host-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "WTK_TARGET_PLATFORM": "host"
      }
    },
    {
      "name": "stm32-debug",
      "displayName": "STM32 Debug",
      "description": "Generic 64-KiB PRODUCT budget check; use the verified UID-bound unit preset for the current full product.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/stm32-debug",
      "toolchainFile": "${sourceDir}/cmake/toolchains/arm-none-eabi-gcc.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS_DEBUG": "-g3",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "WTK_TARGET_PLATFORM": "stm32",
        "WTK_FIRMWARE_PROFILE": "PRODUCT"
      }
    },
    {
      "name": "stm32-release",
      "displayName": "STM32 Release",
      "description": "Generic 64-KiB PRODUCT budget check; use the verified UID-bound unit preset for the current full product.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/stm32-release",
      "toolchainFile": "${sourceDir}/cmake/toolchains/arm-none-eabi-gcc.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS_RELEASE": "-g0 -DNDEBUG",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "WTK_TARGET_PLATFORM": "stm32",
        "WTK_FIRMWARE_PROFILE": "PRODUCT"
      }
    },
    {
      "name": "stm32-bringup-cal",
      "inherits": "stm32-bringup",
      "displayName": "STM32 Calibration Capture Service",
      "binaryDir": "${sourceDir}/build/stm32-bringup-cal",
      "cacheVariables": {
        "WTK_FIRMWARE_PROFILE": "BRINGUP_CAL"
      }
    },
    {
      "name": "stm32-bringup",
      "displayName": "STM32 Bringup",
      "description": "Configure the size-optimized STM32F103C8T6 hardware bringup firmware profile.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/stm32-bringup",
      "toolchainFile": "${sourceDir}/cmake/toolchains/arm-none-eabi-gcc.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "WTK_TARGET_PLATFORM": "stm32",
        "WTK_FIRMWARE_PROFILE": "BRINGUP"
      }
    },
    {
      "name": "stm32-factory-debug",
      "inherits": "stm32-debug",
      "displayName": "Generic 64-KiB factory PRODUCT debug budget check",
      "binaryDir": "${sourceDir}/build/stm32-factory-debug",
      "cacheVariables": {
        "WTK_PRODUCT_FACTORY_PROVISIONED": "ON"
      }
    },
    {
      "name": "stm32-factory-release",
      "inherits": "stm32-release",
      "displayName": "Generic 64-KiB factory PRODUCT release budget check",
      "binaryDir": "${sourceDir}/build/stm32-factory-release",
      "cacheVariables": {
        "WTK_PRODUCT_FACTORY_PROVISIONED": "ON"
      }
    },
    {
      "name": "stm32-unit-release",
      "inherits": "stm32-factory-release",
      "displayName": "Verified first unit PRODUCT (128 KiB, UID bound)",
      "binaryDir": "${sourceDir}/build/stm32-unit-release",
      "cacheVariables": {
        "WTK_INTERNAL_FLASH_KIB": "128",
        "WTK_EXTENDED_FLASH_UID": "54ff70068370525760380567",
        "WTK_NTC_FACTORY_PROFILE": "${sourceDir}/config/units/54ff70068370525760380567-ntc-engineering.json"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "stm32-bringup-cal",
      "configurePreset": "stm32-bringup-cal"
    },
    {
      "name": "host-debug",
      "configurePreset": "host-debug",
      "configuration": "Debug"
    },
    {
      "name": "host-release",
      "configurePreset": "host-release",
      "configuration": "Release"
    },
    {
      "name": "stm32-debug",
      "configurePreset": "stm32-debug",
      "configuration": "Debug"
    },
    {
      "name": "stm32-release",
      "configurePreset": "stm32-release",
      "configuration": "Release"
    },
    {
      "name": "stm32-bringup",
      "configurePreset": "stm32-bringup",
      "configuration": "MinSizeRel"
    },
    {
      "name": "stm32-factory-debug",
      "configurePreset": "stm32-factory-debug"
    },
    {
      "name": "stm32-factory-release",
      "configurePreset": "stm32-factory-release"
    },
    {
      "name": "stm32-unit-release",
      "configurePreset": "stm32-unit-release"
    }
  ],
  "testPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "host-release",
      "configurePreset": "host-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
